# =============================================================================
# SWEEP Configuration Environment File
# =============================================================================

# 1. AWS Aurora RDS PostgreSQL Database Target
export PGHOST=your-aurora-cluster.us-east-2.rds.amazonaws.com
export PGPORT=5432
export PGDATABASE=SWEEPB
export PGUSER=postgres
export PGPASSWORD=your-db-password
export PGSSLMODE=prefer

# 2. AWS S3 Migration Buckets & Region
export AWS_DEFAULT_REGION=us-east-2
export AWS_REGION=us-east-2
export ORACLE_S3_BUCKET=s3://your-migration-bucket/oracle-migration-qa/
export VSAM_S3_BUCKET=s3://your-migration-bucket/vsam-migration-qa/

# 3. Migration Pipeline Performance & Worker Pools
export ORACLE_WORKERS=4
export VSAM_WORKERS=4
export VSAM_CHUNK_ROWS=200000

# 4. VSAM Parser & Formatting Settings
export VSAM_DELIM=auto
export VSAM_QUOTE=auto
export VSAM_ENCODING=UTF8
export VSAM_VERSION_MODE=upsert
export VSAM_COMMON_SCHEMA_CASE=lower
export VSAM_ENABLE_FINTEC=1
export PSQL=psql
