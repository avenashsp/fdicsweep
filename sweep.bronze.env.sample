# =============================================================================
# SWEEP environment of the "bronze" layer  ->  copy to sweep.bronze.env (git-ignored) and fill in
# =============================================================================
# One Aurora cluster, one database per layer. Same host, user and password for every layer (promote copies between
# databases with the credentials of the target layer). NEVER commit the real file: it holds a password.

export PGHOST=your-aurora-cluster.us-east-2.rds.amazonaws.com
export PGPORT=5432
export PGDATABASE=SWEEPB
export PGUSER=postgres
export PGPASSWORD=your-db-password
export PGSSLMODE=prefer

# AWS S3 buckets: only the first layer (bronze) reads S3
export AWS_DEFAULT_REGION=us-east-2
export AWS_REGION=us-east-2
export ORACLE_S3_BUCKET=s3://your-migration-bucket/oracle-migration-qa/
export VSAM_S3_BUCKET=s3://your-migration-bucket/vsam-migration-qa/

export ORACLE_WORKERS=4
export VSAM_WORKERS=4
export PSQL=psql

# Days a delta table is kept after EVERY layer applied it (python3 sweep.py promote --purge)
export SWEEP_DELTA_RETENTION_DAYS=14
